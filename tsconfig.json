{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM"],
    "strict": true, "noUncheckedIndexedAccess": false, "noFallthroughCasesInSwitch": true, "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false, "skipLibCheck": true, "noEmit": true, "allowImportingTsExtensions": true,
    "types": ["@webgpu/types", "bun"]
  },
  "include": ["src", "examples", "viewer", "tests", "tools", "train"]
}
